/*
 * Copy to secrets.h and fill in. secrets.h is gitignored.
 *
 * DEVICE_KEY is this device's own HMAC key. In production it is flashed once at
 * manufacture and never leaves the device; the server keeps it encrypted. The
 * values below are the DEMO keys from apps/api/src/seed/seed.ts, which exist so
 * the simulator and the tests can sign - never use them on a real device.
 */
#define WIFI_SSID "your-network"
#define WIFI_PASSWORD "your-password"

// The API host. On a demo hotspot this is the laptop's address.
#define API_BASE "http://192.168.1.50:4000"

#define DEVICE_ID "HB-001"
#define DEVICE_KEY "demo-key-home-lakshmi-bedroom"
