{
  "name": "@safecircle/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch --enable-source-maps dist/index.js",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/index.js",
    "migrate": "tsc -b && node --env-file-if-exists=../../.env dist/db/migrate.js",
    "reset": "tsc -b && node --env-file-if-exists=../../.env dist/db/migrate.js --reset",
    "seed": "tsc -b && node --env-file-if-exists=../../.env dist/seed/seed.js",
    "test": "tsc -b && tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist-test/test/*.test.js"
  },
  "dependencies": {
    "@safecircle/shared": "*",
    "fastify": "^5.2.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10"
  }
}